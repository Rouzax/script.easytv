<?xml version="1.0" encoding="UTF-8"?>
<!--
    EasyTV Select Dialog
    Resolution: 1080i (1920x1080)

    Single-select (default): clicking an item selects it and closes the
    dialog, no checkboxes or buttons shown, sized exactly as the original
    select dialog.
    Multi-select: items toggle a checkbox, an OK button (id 10) confirms
    the selection, a Back button (id 11) cancels; both hidden in
    single-select mode so that mode still renders exactly as before.

    Window properties:
        EasyTV.SingleSelect - "true" hides checkboxes and the button row

    ListItem properties:
        is_header - "true" marks a non-selectable group header row
        checked   - "true" marks a checked row (multi-select mode)

    Control IDs:
        1   - Heading label
        100 - Scrollable list
        10  - OK button (multi-select only)
        11  - Back button (multi-select only)
-->
<window>
    <zorder>1</zorder>
    <defaultcontrol always="true">100</defaultcontrol>

    <controls>
        <!-- Dim overlay -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="BB000000">easytv/white.png</texture>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="300" />
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="300" />
            </animation>
        </control>

        <!-- Dialog Container: anchored at the original single-select position -->
        <control type="group">
            <left>660</left>
            <top>280</top>
            <width>600</width>
            <height>580</height>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="300" delay="100" />
                <effect type="slide" start="0,-100" end="0" center="auto" tween="back" easing="out" time="600" delay="100" />
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="zoom" start="100" end="95" center="auto" tween="sine" easing="out" time="300" />
                <effect type="fade" start="100" end="0" tween="cubic" easing="out" time="300" />
            </animation>

            <!-- Accent border frame: single-select size (matches the original dialog) -->
            <control type="image">
                <left>-2</left>
                <top>-2</top>
                <width>604</width>
                <height>524</height>
                <texture border="12" colordiffuse="$INFO[Window.Property(EasyTV.Accent)]">easytv/white_rounded.png</texture>
                <visible>String.IsEqual(Window.Property(EasyTV.SingleSelect),true)</visible>
            </control>

            <!-- Rounded dark panel background: single-select size -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>600</width>
                <height>520</height>
                <texture border="12">easytv/menu.png</texture>
                <colordiffuse>ffffffff</colordiffuse>
                <visible>String.IsEqual(Window.Property(EasyTV.SingleSelect),true)</visible>
            </control>

            <!-- Accent border frame: multi-select size (room for the button row) -->
            <control type="image">
                <left>-2</left>
                <top>-2</top>
                <width>604</width>
                <height>584</height>
                <texture border="12" colordiffuse="$INFO[Window.Property(EasyTV.Accent)]">easytv/white_rounded.png</texture>
                <visible>!String.IsEqual(Window.Property(EasyTV.SingleSelect),true)</visible>
            </control>

            <!-- Rounded dark panel background: multi-select size -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>600</width>
                <height>580</height>
                <texture border="12">easytv/menu.png</texture>
                <colordiffuse>ffffffff</colordiffuse>
                <visible>!String.IsEqual(Window.Property(EasyTV.SingleSelect),true)</visible>
            </control>

            <!-- Heading Label (ID 1) -->
            <control type="label" id="1">
                <left>30</left>
                <top>13</top>
                <width>540</width>
                <height>40</height>
                <align>center</align>
                <textcolor>$INFO[Window.Property(EasyTV.Accent)]</textcolor>
                <font>font36_title</font>
                <label>-</label>
            </control>

            <!-- Accent line separator -->
            <control type="image">
                <left>30</left>
                <top>66</top>
                <width>540</width>
                <height>2</height>
                <texture colordiffuse="$INFO[Window.Property(EasyTV.AccentGlow)]">easytv/line_fade.png</texture>
            </control>

            <!-- Scrollable list (ID 100) -->
            <control type="list" id="100">
                <left>30</left>
                <top>82</top>
                <width>540</width>
                <height>418</height>
                <orientation>vertical</orientation>
                <scrolltime tween="sine" easing="out">200</scrolltime>
                <onleft>100</onleft>
                <onright>10</onright>
                <onup>100</onup>
                <ondown>11</ondown>

                <!-- Unfocused item -->
                <itemlayout width="540" height="50">
                    <!-- Header row: dimmed, centered label -->
                    <control type="label">
                        <left>0</left>
                        <top>0</top>
                        <width>540</width>
                        <height>50</height>
                        <align>center</align>
                        <aligny>center</aligny>
                        <font>font10</font>
                        <textcolor>66FFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEqual(ListItem.Property(is_header),true)</visible>
                    </control>

                    <!-- Checkbox: unchecked (multi-select only) -->
                    <control type="image">
                        <left>10</left>
                        <top>13</top>
                        <width>24</width>
                        <height>24</height>
                        <texture colordiffuse="44FFFFFF">easytv/check_off.png</texture>
                        <visible>[!String.IsEqual(ListItem.Property(checked),true)] + !String.IsEqual(Window.Property(EasyTV.SingleSelect),true) + !String.IsEqual(ListItem.Property(is_header),true)</visible>
                    </control>
                    <!-- Checkbox: checked (multi-select only) -->
                    <control type="image">
                        <left>10</left>
                        <top>13</top>
                        <width>24</width>
                        <height>24</height>
                        <texture colordiffuse="$INFO[Window.Property(EasyTV.Accent)]">easytv/check_on.png</texture>
                        <visible>[String.IsEqual(ListItem.Property(checked),true)] + !String.IsEqual(Window.Property(EasyTV.SingleSelect),true) + !String.IsEqual(ListItem.Property(is_header),true)</visible>
                    </control>

                    <!-- Label: with checkbox offset (multi-select) -->
                    <control type="label">
                        <left>48</left>
                        <top>0</top>
                        <width>480</width>
                        <height>50</height>
                        <aligny>center</aligny>
                        <font>font12</font>
                        <textcolor>FFCCCCCC</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>!String.IsEqual(Window.Property(EasyTV.SingleSelect),true) + !String.IsEqual(ListItem.Property(is_header),true)</visible>
                    </control>
                    <!-- Label: no offset (single-select) -->
                    <control type="label">
                        <left>15</left>
                        <top>0</top>
                        <width>510</width>
                        <height>50</height>
                        <aligny>center</aligny>
                        <font>font12</font>
                        <textcolor>FFCCCCCC</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEqual(Window.Property(EasyTV.SingleSelect),true) + !String.IsEqual(ListItem.Property(is_header),true)</visible>
                    </control>
                </itemlayout>

                <!-- Focused item -->
                <focusedlayout width="540" height="50">
                    <!-- Accent background (hidden for headers) -->
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>540</width>
                        <height>50</height>
                        <texture colordiffuse="$INFO[Window.Property(EasyTV.AccentBG)]">easytv/white.png</texture>
                        <visible>!String.IsEqual(ListItem.Property(is_header),true)</visible>
                    </control>

                    <!-- Header row: dimmed, centered label (no highlight) -->
                    <control type="label">
                        <left>0</left>
                        <top>0</top>
                        <width>540</width>
                        <height>50</height>
                        <align>center</align>
                        <aligny>center</aligny>
                        <font>font10</font>
                        <textcolor>66FFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEqual(ListItem.Property(is_header),true)</visible>
                    </control>

                    <!-- Checkbox: unchecked (multi-select only) -->
                    <control type="image">
                        <left>10</left>
                        <top>13</top>
                        <width>24</width>
                        <height>24</height>
                        <texture colordiffuse="66FFFFFF">easytv/check_off.png</texture>
                        <visible>[!String.IsEqual(ListItem.Property(checked),true)] + !String.IsEqual(Window.Property(EasyTV.SingleSelect),true) + !String.IsEqual(ListItem.Property(is_header),true)</visible>
                    </control>
                    <!-- Checkbox: checked (multi-select only) -->
                    <control type="image">
                        <left>10</left>
                        <top>13</top>
                        <width>24</width>
                        <height>24</height>
                        <texture colordiffuse="$INFO[Window.Property(EasyTV.Accent)]">easytv/check_on.png</texture>
                        <visible>[String.IsEqual(ListItem.Property(checked),true)] + !String.IsEqual(Window.Property(EasyTV.SingleSelect),true) + !String.IsEqual(ListItem.Property(is_header),true)</visible>
                    </control>

                    <!-- Label: with checkbox offset (multi-select) -->
                    <control type="label">
                        <left>48</left>
                        <top>0</top>
                        <width>480</width>
                        <height>50</height>
                        <aligny>center</aligny>
                        <font>font12</font>
                        <textcolor>$INFO[Window.Property(EasyTV.Accent)]</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>!String.IsEqual(Window.Property(EasyTV.SingleSelect),true) + !String.IsEqual(ListItem.Property(is_header),true)</visible>
                    </control>
                    <!-- Label: no offset (single-select) -->
                    <control type="label">
                        <left>15</left>
                        <top>0</top>
                        <width>510</width>
                        <height>50</height>
                        <aligny>center</aligny>
                        <font>font12</font>
                        <textcolor>$INFO[Window.Property(EasyTV.Accent)]</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEqual(Window.Property(EasyTV.SingleSelect),true) + !String.IsEqual(ListItem.Property(is_header),true)</visible>
                    </control>
                </focusedlayout>
            </control>

            <!-- Button Row: hidden entirely in single-select mode so that
                 mode keeps the original list-only appearance -->
            <control type="grouplist">
                <left>85</left>
                <top>515</top>
                <width>430</width>
                <height>50</height>
                <align>center</align>
                <itemgap>30</itemgap>
                <orientation>horizontal</orientation>
                <onup>100</onup>
                <visible>!String.IsEqual(Window.Property(EasyTV.SingleSelect),true)</visible>

                <!-- Back Button (ID 11) -->
                <control type="button" id="11">
                    <width>200</width>
                    <height>50</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <font>font12</font>
                    <textoffsetx>10</textoffsetx>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>$INFO[Window.Property(EasyTV.ButtonTextFocused)]</focusedcolor>
                    <onup>100</onup>
                    <label>$ADDON[script.easytv 32081]</label>
                    <texturefocus border="12" colordiffuse="$INFO[Window.Property(EasyTV.ButtonFocus)]">easytv/white_rounded.png</texturefocus>
                    <texturenofocus border="12" colordiffuse="1fFFFFFF">easytv/white_rounded.png</texturenofocus>
                </control>

                <!-- OK Button (ID 10) -->
                <control type="button" id="10">
                    <width>200</width>
                    <height>50</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <font>font12</font>
                    <textoffsetx>10</textoffsetx>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>$INFO[Window.Property(EasyTV.ButtonTextFocused)]</focusedcolor>
                    <onup>100</onup>
                    <label>$ADDON[script.easytv 32080]</label>
                    <texturefocus border="12" colordiffuse="$INFO[Window.Property(EasyTV.ButtonFocus)]">easytv/white_rounded.png</texturefocus>
                    <texturenofocus border="12" colordiffuse="1fFFFFFF">easytv/white_rounded.png</texturenofocus>
                </control>
            </control>
        </control>
    </controls>
</window>
